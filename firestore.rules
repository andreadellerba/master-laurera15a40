rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // L'app legge/scrive solo clubs/laurera15a40/data/{main,tornei,fanta,albo,log}
    // (vedi _doc() in index.html). Progetto Firebase: laurera15a40-1d606
    match /clubs/{clubId}/data/{docId} {
      // Lettura pubblica: la app mostra i dati anche a chi non ha fatto login (modalità viewer).
      allow read: if true;

      // Scrittura solo da utente autenticato (solo l'admin conosce email/password)
      // e solo sui documenti effettivamente usati dall'app.
      allow write: if request.auth != null
                   && docId in ['main', 'tornei', 'fanta', 'albo', 'log', 'foto'];
    }

    // Visite anonime: ogni dispositivo scrive solo il proprio contatore (nessun login),
    // solo l'admin può leggere, dire di chi è il dispositivo o cancellarlo.
    match /clubs/{clubId}/visite/{devId} {
      allow read, delete: if request.auth != null;

      // nuovo dispositivo (o dispositivo tolto dalla lista che torna): contatore a 1
      allow create: if devId.size() == 24
                    && request.resource.data.keys().hasOnly(['first', 'last', 'n', 'dev', 'br', 'app', 'days', 'log'])
                    && request.resource.data.get('first', request.time) == request.time
                    && request.resource.data.last == request.time
                    && request.resource.data.n == 1
                    && request.resource.data.dev is string && request.resource.data.dev.size() <= 20
                    && request.resource.data.get('br', '') is string && request.resource.data.get('br', '').size() <= 20
                    && request.resource.data.get('app', false) is bool
                    && request.resource.data.get('days', {}) is map && request.resource.data.get('days', {}).size() <= 1
                    && request.resource.data.get('log', []) is list && request.resource.data.get('log', []).size() <= 1;

      // visitatore: aggiorna ora, contatore (+1), tipo di dispositivo/browser, visite del giorno e orario dell'accesso
      allow update: if request.auth == null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'n', 'dev', 'br', 'app', 'days', 'log'])
                    && request.resource.data.last == request.time
                    && request.resource.data.n == resource.data.n + 1
                    && request.resource.data.dev is string && request.resource.data.dev.size() <= 20
                    && request.resource.data.get('br', '') is string && request.resource.data.get('br', '').size() <= 20
                    && request.resource.data.get('app', false) is bool
                    && request.resource.data.get('days', {}) is map && request.resource.data.get('days', {}).size() <= 400
                    && request.resource.data.get('log', []) is list && request.resource.data.get('log', []).size() <= resource.data.get('log', []).size() + 1
                    && request.resource.data.get('log', []).size() <= 5000;

      // admin: può solo dire di chi è il dispositivo (giocatore e/o nome)
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'pid', 'auto'])
                    && request.resource.data.get('nome', '') is string && request.resource.data.get('nome', '').size() <= 40
                    && (request.resource.data.get('pid', 0) is int || request.resource.data.get('pid', 0) is float);

      // "Chi sei?": il socio sceglie il proprio nome una sola volta (se il dispositivo non ha già un giocatore)
      allow update: if request.auth == null
                    && !('pid' in resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pid', 'nome', 'auto'])
                    && (request.resource.data.pid is int || request.resource.data.pid is float)
                    && request.resource.data.nome is string && request.resource.data.nome.size() <= 40
                    && request.resource.data.auto == true;
    }

    // Reazioni ai risultati (🔥 👏 😍 💪 🤯 😂 🎾 🏆): chiunque può leggerle; senza login si può solo
    // aggiungere o togliere UNA reazione alla volta (+1 o -1 su un solo contatore, mai sotto zero).
    match /clubs/{clubId}/reazioni/{mid} {
      allow read: if true;
      allow delete: if request.auth != null;

      // prima reazione su una partita: un solo contatore, a 1
      allow create: if mid.size() <= 20
                    && request.resource.data.keys().hasOnly(['f', 'c', 'h', 'p', 'w', 'l', 't', 'k'])
                    && request.resource.data.keys().size() == 1
                    && request.resource.data.values()[0] == 1;

      // reazioni successive: cambia un solo contatore, di +1 o -1
      allow update: if request.resource.data.keys().hasOnly(['f', 'c', 'h', 'p', 'w', 'l', 't', 'k'])
                    && request.resource.data.diff(resource.data).affectedKeys().size() == 1
                    && (reazioneUnPasso('f') || reazioneUnPasso('c') || reazioneUnPasso('h') || reazioneUnPasso('p')
                        || reazioneUnPasso('w') || reazioneUnPasso('l') || reazioneUnPasso('t') || reazioneUnPasso('k'));
    }
    // vero se la modifica riguarda solo il contatore k e lo sposta di +1 o -1 (mai sotto zero)
    function reazioneUnPasso(k) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([k])
          && request.resource.data[k] is int
          && request.resource.data[k] >= 0
          && (request.resource.data[k] == resource.data.get(k, 0) + 1
              || request.resource.data[k] == resource.data.get(k, 0) - 1);
    }

    // Chi ha messo le reazioni: ogni telefono scrive solo il proprio documento "partita_telefono";
    // li legge solo l'admin (tenendo premuta una faccina).
    match /clubs/{clubId}/reazioni_chi/{docId} {
      allow read, delete: if request.auth != null;
      allow create, update: if docId.size() <= 50
                    && request.resource.data.keys().hasOnly(['mid', 'k', 'nome', 'pid'])
                    && request.resource.data.mid is string && request.resource.data.mid.size() <= 20
                    && docId.matches(request.resource.data.mid + '_[0-9a-f]{24}')
                    && request.resource.data.k is list && request.resource.data.k.size() <= 8
                    && request.resource.data.nome is string && request.resource.data.nome.size() <= 40;
    }

    // Commenti alle partite: chiunque li legge; senza login si può solo aggiungerne uno nuovo
    // (testo fino a 200 caratteri, firmato col nome scelto in "Chi sei?"). Solo l'admin li cancella, nessuno li modifica.
    match /clubs/{clubId}/commenti/{cid} {
      allow read: if true;
      allow delete: if request.auth != null;
      allow create: if request.resource.data.keys().hasOnly(['mid', 'testo', 'nome', 'pid', 't'])
                    && request.resource.data.keys().hasAll(['mid', 'testo', 'nome', 't'])
                    && request.resource.data.mid is string && request.resource.data.mid.size() >= 1 && request.resource.data.mid.size() <= 20
                    && request.resource.data.testo is string && request.resource.data.testo.size() >= 1 && request.resource.data.testo.size() <= 200
                    && request.resource.data.nome is string && request.resource.data.nome.size() >= 1 && request.resource.data.nome.size() <= 40
                    && (request.resource.data.get('pid', null) == null || request.resource.data.pid is int || request.resource.data.pid is float)
                    && request.resource.data.t == request.time;
    }

    // Complimenti e adesivi: chiunque li legge; senza login si può solo mandarne uno nuovo
    // (uno dei 6 adesivi, mai a se stessi). Solo l'admin li cancella, nessuno li modifica.
    match /clubs/{clubId}/complimenti/{cid} {
      allow read: if true;
      allow delete: if request.auth != null;
      allow create: if request.resource.data.keys().hasOnly(['to', 'k', 'da', 'dpid', 't'])
                    && request.resource.data.keys().hasAll(['to', 'k', 'da', 't'])
                    && (request.resource.data.to is int || request.resource.data.to is float)
                    && request.resource.data.k in ['gp', 'sv', 'mu', 'ri', 'cl', 'fa']
                    && request.resource.data.da is string && request.resource.data.da.size() >= 1 && request.resource.data.da.size() <= 40
                    && (request.resource.data.get('dpid', null) == null || request.resource.data.dpid is int || request.resource.data.dpid is float)
                    && request.resource.data.get('dpid', null) != request.resource.data.to
                    && request.resource.data.t == request.time;
    }

    // Tutto il resto: negato di default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
